{"format":"helia-content","version":1,"id":"golabki","title":{"Inline":[{"Text":"Gołąbki (Stuffed Cabbage)"}]},"title_text":"Gołąbki (Stuffed Cabbage)","kind":"recipe","taxon":null,"url":"golabki.html","content":{"Block":[{"Group":{"role":"recipe-card","attrs":[["entry","golabki"],["kind","recipe"]],"body":{"Block":[{"Group":{"role":"recipe-facts","attrs":[["compact","true"]],"body":{"Inline":[{"Span":{"role":"recipe-fact","attrs":[],"body":[{"Span":{"role":"recipe-fact-label","attrs":[],"body":[{"Text":"Cook"}]}},{"Text":" "},{"Span":{"role":"recipe-fact-value","attrs":[],"body":[{"Text":"4 h"}]}}]}}]}}},{"Group":{"role":"recipe-card-cols","attrs":[],"body":{"Block":[{"Group":{"role":"recipe-ingredients","attrs":[],"body":{"Block":[{"Paragraph":[{"Span":{"role":"recipe-label","attrs":[],"body":[{"Text":"Ingredients"}]}}]},{"List":{"marker":null,"tight":true,"items":[{"Inline":[{"Span":{"role":"recipe-qty","attrs":[],"body":[{"Text":"5 pounds"}]}},{"Text":" "},{"Span":{"role":"recipe-item","attrs":[],"body":[{"Text":"cheap beef"}]}}]},{"Inline":[{"Span":{"role":"recipe-qty","attrs":[],"body":[{"Text":"1 pound"}]}},{"Text":" "},{"Span":{"role":"recipe-item","attrs":[],"body":[{"Text":"bacon"}]}}]},{"Inline":[{"Span":{"role":"recipe-qty","attrs":[],"body":[{"Text":"4"}]}},{"Text":" "},{"Span":{"role":"recipe-item","attrs":[],"body":[{"Text":"large onions"}]}}]},{"Inline":[{"Span":{"role":"recipe-qty","attrs":[],"body":[{"Text":"3 cans"}]}},{"Text":" "},{"Span":{"role":"recipe-item","attrs":[],"body":[{"Text":"tomato bisque"}]}}]},{"Inline":[{"Span":{"role":"recipe-qty","attrs":[],"body":[{"Text":"3 large cans"}]}},{"Text":" "},{"Span":{"role":"recipe-item","attrs":[],"body":[{"Text":"stewed tomatoes"}]}}]},{"Inline":[{"Span":{"role":"recipe-qty","attrs":[],"body":[{"Text":"4"}]}},{"Text":" "},{"Span":{"role":"recipe-item","attrs":[],"body":[{"Text":"large cabbages"}]}}]},{"Inline":[{"Span":{"role":"recipe-qty","attrs":[],"body":[{"Text":"3"}]}},{"Text":" "},{"Span":{"role":"recipe-item","attrs":[],"body":[{"Text":"large eggs"}]}}]}]}}]}}},{"Group":{"role":"recipe-method","attrs":[],"body":{"Block":[{"Paragraph":[{"Span":{"role":"recipe-label","attrs":[],"body":[{"Text":"Method"}]}}]},{"Enum":{"numbering":null,"start":1,"tight":true,"items":[{"number":null,"body":{"Inline":[{"Text":"Cook bacon and reserve grease. Crumble bacon, then add bacon and grease to the 5 pounds of beef."}]}},{"number":null,"body":{"Inline":[{"Text":"Squeeze liquid out of stewed tomatoes and reserve the liquid. Add the tomato solids into the beef."}]}},{"number":null,"body":{"Inline":[{"Text":"Add egg and rice to beef, mix until homogenous."}]}},{"number":null,"body":{"Inline":[{"Text":"Bring a pot of water to boil. Core the cabbage then add to the pot."}]}},{"number":null,"body":{"Inline":[{"Text":"Wiggle the leaves off the heads of cabbage. Don’t pull the leaves off forcefully, they should release easily. Put the removed leaves aside to cool. Keep any leaves that are too small or have torn."}]}},{"number":null,"body":{"Inline":[{"Text":"Preheat the oven to 350 Fahrenheit."}]}},{"number":null,"body":{"Inline":[{"Text":"Begin to assemble rolls of cabbage. Put a serving of meat in the middle of a leaf of cabbage, then roll tightly like a burrito. Begin layering the completed rolls in a large roasting pan."}]}},{"number":null,"body":{"Inline":[{"Text":"After one layer of rolls is filled, add salt, pepper, tomato bisque, the reserve tomato liquid, and the torn scraps of cabbage leaves on top."}]}},{"number":null,"body":{"Inline":[{"Text":"Repeat until the pan is full or you have run out of ingredients."}]}},{"number":null,"body":{"Inline":[{"Text":"Roast for 4 hours. Time permitting, reduce the temperature to 275 halfway through roasting. Ideally the lower and slower, the better."}]}}]}}]}}}]}}}]}}}]}}
