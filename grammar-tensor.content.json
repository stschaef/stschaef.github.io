{"format":"helia-content","version":1,"id":"grammar-tensor","title":{"Inline":[{"Text":"Tensor of Grammars"}]},"title_text":"Tensor of Grammars","kind":"definition","taxon":null,"url":"grammar-tensor.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","grammar-tensor"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"For "},{"EntryLink":{"id":"formal-grammar","label":null,"body":[{"Text":"formal grammars"}]}},{"Text":" "},{"Math":{"src":"A"}},{"Text":" and "},{"Math":{"src":"B"}},{"Text":", their tensor "},{"Math":{"src":"A ⊗ B"}},{"Text":" represents the concatenation of the languages they describe. A parse for "},{"Math":{"src":"A ⊗ B"}},{"Text":" at a string "},{"Math":{"src":"w"}},{"Text":" consists of a "},{"Emph":[{"Text":"splitting"}]},{"Text":" of "},{"Math":{"src":"w"}},{"Text":" into a prefix "},{"Math":{"src":"u"}},{"Text":" and suffix "},{"Math":{"src":"v"}},{"Text":", along with a parse of "},{"Math":{"src":"u"}},{"Text":" in "},{"Math":{"src":"A"}},{"Text":" and a parse of "},{"Math":{"src":"v"}},{"Text":" in "},{"Math":{"src":"B"}},{"Text":"."}]},{"Paragraph":[{"Text":"Formally, it is defined as:"}]},{"Math":{"src":"(A ⊗ B)(w) = sum_(w = u v) A(u) times B(v)"}},{"Paragraph":[{"Text":"This operation is exactly the "},{"EntryLink":{"id":"day-convolution","label":null,"body":[{"Text":"Day convolution"}]}},{"Text":" of "},{"Math":{"src":"A"}},{"Text":" and "},{"Math":{"src":"B"}},{"Text":", where we view formal grammars as presheaves over the monoid of strings."}]}]}}}]}}
