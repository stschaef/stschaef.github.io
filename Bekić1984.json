 {1984},\n isbn = {978-3-540-38933-0},\n doi = {10.1007/BFb0048939},\n url = {https://doi.org/10.1007/BFb0048939},\n booktitle = {Programming languages and their definition: {H}. {Bekič} (1936–1982)},\n editor = {Jones, C. B.},\n pages = {30--55},\n publisher = {Springer Berlin Heidelberg},\n address = {Berlin, Heidelberg},\n abstract = {We study the class of operations definable from the given operations of an algebra of sets by union, composition, and fixed points; we obtain two theorems on definable operations that give us as special case the regular-equals-recognisable theorem of generalised finite automata theory. Definable operations arise also as the operations computable by charts; by translating into predicate logic, we obtain Manna's formulas for termination and correctness of flowcharts.}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"container"},{"t":"str","v":"Programming languages and their definition: H. Bekič (1936–1982)"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"doi"},{"t":"str","v":"10.1007/bfb0048939"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"entry-type"},{"t":"str","v":"chapter"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"pages"},{"t":"str","v":"30--55"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"publisher"},{"t":"str","v":"Springer Berlin Heidelberg"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"url"},{"t":"str","v":"https://doi.org/10.1007/BFb0048939"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"year"},{"t":"int","v":1984}]},{"relation":"path","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v":"entries/refs/Bekić1984/Bekić1984.hel"}]},{"relation":"reference","args":[{"t":"entry","v":"Bekić1984"},{"t":"str","v"