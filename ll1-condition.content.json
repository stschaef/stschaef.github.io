{"format":"helia-content","version":1,"id":"ll1-condition","title":{"Inline":[{"Text":"LL(1) Condition"}]},"title_text":"LL(1) Condition","kind":"definition","taxon":null,"url":"ll1-condition.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","ll1-condition"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"A context-free grammar satisfies the "},{"Emph":[{"Text":"LL(1) condition"}]},{"Text":" if it satisfies the following three conditions:"}]},{"List":{"marker":null,"tight":true,"items":[{"Inline":[{"Text":"All of its productions have pairwise disjoint "},{"EntryLink":{"id":"first-set","label":null,"body":[{"Text":"first sets"}]}}]},{"Inline":[{"Text":"If a concatenation of nonterminals "},{"Math":{"src":"A times.o B"}},{"Text":" appears in a production, then "},{"Math":{"src":"A"}},{"Text":" has a disjoint "},{"EntryLink":{"id":"followlast-set","label":null,"body":[{"Text":"followlast set"}]}},{"Text":" from the "},{"EntryLink":{"id":"first-set","label":null,"body":[{"Text":"first set"}]}},{"Text":" of "},{"Math":{"src":"B"}}]},{"Inline":[{"Text":"At most one production is "},{"EntryLink":{"id":"nullable-grammar","label":null,"body":[{"Text":"nullable"}]}}]}]}},{"Paragraph":[{"Text":"This is essentially the type system of "},{"Cite":{"key":"krishnaswami_typed_2019","supplement":null,"rendered":"[1]"}},{"Text":", which characterizes the LL(1) condition for context-free expressions."}]},{"Paragraph":[{"Text":"Intutively, an LL(1) grammar can be parsed unambiguously, and without backtracking, by a predictive parser that only needs one token of lookahead."}]}]}}}]}}
