,"v":29},{"t":"str","v":"title:encoding second order string acg with deterministic tree walking transducers salvati fg 2006|2006"}]},{"relation":"cites-key","args":[{"t":"entry","v":"Guillaume2024"},{"t":"int","v":30},{"t":"str","v":"title:principles of database and knowledge base systems volume ii ullman|1990"}]},{"relation":"cites-key","args":[{"t":"entry","v":"Guillaume2024"},{"t":"int","v":31},{"t":"str","v":"title:characterizing mildly context sensitive grammar formalisms weir phd thesis|1988"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"Guillaume2024"}]},{"relation":"import","args":[{"t":"entry","v":"Guillaume2024"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"bibtex"},{"t":"str","v":"@inproceedings{Guillaume2024,\n title = {ACGtk: A Toolkit for Developing and Running Abstract Categorial Grammars},\n author = {Guillaume, Maxime and Pogodalla, Sylvain and Tourneur, Vincent},\n year = {2024},\n isbn = {978-981-97-2299-0},\n doi = {10.1007/978-981-97-2300-3_2},\n url = {https://doi.org/10.1007/978-981-97-2300-3_2},\n booktitle = {Functional and Logic Programming: 17th International Symposium, FLOPS 2024, Kumamoto, Japan, May 15–17, 2024, Proceedings},\n pages = {13–30},\n publisher = {Springer-Verlag},\n address = {Berlin, Heidelberg},\n location = {Kumamoto, Japan},\n keywords = {Abstract Categorial Grammars, Natural Language Processing, OCaml, Datalog},\n numpages = {18},\n abstract = {Abstract categorial grammars (ACGs) is an expressive grammatical framework whose formal properties have been extensively studied. While it can provide its own account, as a grammar, of linguistic phenomena, it is known to encode several grammatical formalisms, including context-free grammars, but also mildly context-sensitive formalisms such as tree-adjoining grammars or m-linear context-free rewriting systems for which parsing is polynomial. The ACG toolkit we present provides a compiler, acgc, that checks and turns ACGs into representations that are suitable for testing and parsing, used in the acg interpreter. We illustrate these functionalities and discuss implementation features, in particular the Datalog reduction on which parsing is based, and the magic set rewriting techniques that can further be applied.}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"container"},{"t":"str","v":"Functional and Logic Programming: 17th International Symposium, FLOPS 2024, Kumamoto, Japan, May 15–17, 2024, Proceedings"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"doi"},{"t":"str","v":"10.1007/978-981-97-2300-3_2"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"entry-type"},{"t":"str","v":"inproceedings"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"pages"},{"t":"str","v":"13–30"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"publisher"},{"t":"str","v":"Springer-Verlag"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"url"},{"t":"str","v":"https://doi.org/10.1007/978-981-97-2300-3_2"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"venue"},{"t":"str","v":"flops"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"year"},{"t":"int","v":2024}]},{"relation":"path","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"entries/refs/Guillaume2024/Guillaume2024.hel"}]},{"relation":"reference","args":[{"t":"entry","v":"Guillaume2024"},{"t":"str","v":"inproceedings"},{"t":"int","v":2024}]},{"relation":"referen