{"format":"helia-content","version":1,"id":"terminal-coalgebra","title":{"Inline":[{"Text":"Terminal coalgebra"}]},"title_text":"Terminal coalgebra","kind":"definition","taxon":null,"url":"terminal-coalgebra.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","terminal-coalgebra"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"Fix an endofunctor "},{"Math":{"src":"F : cal(C) -> cal(C)"}},{"Text":". A "},{"Emph":[{"Text":"terminal "},{"Math":{"src":"F"}},{"Text":"-coalgebra"}]},{"Text":", written "},{"Math":{"src":"nu F"}},{"Text":", is a terminal object of the "},{"EntryLink":{"id":"coalgebras-displayed","label":null,"body":[{"Text":"category of coalgebras"}]}},{"Text":" "},{"Math":{"src":"\"Coalg\" lr(( F ))"}},{"Text":" — equivalently, an "},{"EntryLink":{"id":"initial-algebra","label":null,"body":[{"Text":"initial algebra"}]}},{"Text":" for "},{"Math":{"src":"F^(\"op\")"}},{"Text":"."}]},{"Paragraph":[{"Text":"Unfolding the universal property: a terminal coalgebra is a coalgebra "},{"Math":{"src":"lr(( nu F \\, \"out\" ))"}},{"Text":" such that every coalgebra "},{"Math":{"src":"lr(( x \\, gamma ))"}},{"Text":" admits a unique morphism "},{"Math":{"src":"\"unfold\" thick gamma : x -> nu F"}},{"Text":" satisfying"}]},{"Math":{"src":"lr(( \"unfold\" thick gamma )) ⋆ \"out\" = gamma ⋆ F lr(( \"unfold\" thick gamma )) ."}}]}}}]}}
