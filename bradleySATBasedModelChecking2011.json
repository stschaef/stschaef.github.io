ion":"cites-key","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"int","v":23},{"t":"str","v":"title:cut sweeping een cadence tech report|2007"}]},{"relation":"cites-key","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"int","v":24},{"t":"str","v":"title:fast illegal state identification for improving sat based induction|2006"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":""}]},{"relation":"date","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"date","v":"2011-01-23"}]},{"relation":"entry","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"}]},{"relation":"import","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"bibtex"},{"t":"str","v":"@inproceedings{bradleySATBasedModelChecking2011,\n title = {{{SAT-Based Model Checking}} without {{Unrolling}}},\n author = {Bradley, Aaron},\n date = {2011-01-23},\n isbn = {978-3-642-18274-7},\n doi = {10.1007/978-3-642-18275-4_7},\n pages = {70--87},\n abstract = {A new form of SAT-based symbolic model checking is described. Instead of unrolling the transition relation, it incrementally generates clauses that are inductive relative to (and augment) stepwise approximate reachability information. In this way, the algorithm gradually refines the property, eventually producing either an inductive strengthening of the property or a counterexample trace. Our experimental studies show that induction is a powerful tool for generalizing the unreachability of given error states: it can refine away many states at once, and it is effective at focusing the proof search on aspects of the transition system relevant to the property. Furthermore, the incremental structure of the algorithm lends itself to a parallel implementation.},\n booktitle = {Verification, Model Checking, and Abstract Interpretation (VMCAI 2011)},\n series = {Lecture Notes in Computer Science},\n volume = {6538}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"container"},{"t":"str","v":"Verification, Model Checking, and Abstract Interpretation"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"date"},{"t":"date","v":"2011-01-23"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"doi"},{"t":"str","v":"10.1007/978-3-642-18275-4_7"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"entry-type"},{"t":"str","v":"inproceedings"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"pages"},{"t":"str","v":"70–87"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"publisher"},{"t":"str","v":"Springer"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"venue"},{"t":"str","v":"vmcai"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"volume"},{"t":"str","v":"6538"}]},{"relation":"meta","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"year"},{"t":"int","v":2011}]},{"relation":"path","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"entries/refs/bradleySATBasedModelChecking2011/bradleySATBasedModelChecking2011.hel"}]},{"relation":"reference","args":[{"t":"entry","v":"bradleySATBasedModelChecking2011"},{"t":"str","v":"inproceedings"},{"t":"int","v":2011}]},{"relation":"reference-pdf",