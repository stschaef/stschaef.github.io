{"format":"helia-content","version":1,"id":"grammar-quotients","title":{"Inline":[{"Text":"Grammar Quotients"}]},"title_text":"Grammar Quotients","kind":"definition","taxon":null,"url":"grammar-quotients.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","grammar-quotients"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"For "},{"EntryLink":{"id":"formal-grammar","label":null,"body":[{"Text":"formal grammars"}]}},{"Text":" "},{"Math":{"src":"A"}},{"Text":" and "},{"Math":{"src":"B"}},{"Text":", the "},{"Emph":[{"Text":"quotient"}]},{"Text":" of "},{"Math":{"src":"B"}},{"Text":" by "},{"Math":{"src":"A"}},{"Text":" is the grammar of what is left of "},{"Math":{"src":"B"}},{"Text":" once an "},{"Math":{"src":"A"}},{"Text":" has been read off the front:"}]},{"Math":{"src":"(D_A B)(v) = Sigma_u A(u) times B(u dot.c v)"}},{"Paragraph":[{"Text":"A parse of the quotient consists of an "},{"Math":{"src":"A"}},{"Text":"-parses at prefix "},{"Math":{"src":"u"}},{"Text":" and a "},{"Math":{"src":"B"}},{"Text":"-parse of the full string "},{"Math":{"src":"u dot.c v"}},{"Text":"."}]},{"Paragraph":[{"Text":"This operation has a right adjoint:"}]},{"Math":{"src":"(root(A, C))(w) = Pi_(u, v) (u dot.c v = w) -> A(u) -> C(v)"}},{"Paragraph":[{"Text":"Intuitively, "},{"Math":{"src":"root(A,C)"}},{"Text":" parses "},{"Math":{"src":"w"}},{"Text":" if: for all splittings of "},{"Math":{"src":"w"}},{"Text":" into a prefix and suffix, if the prefix matches "},{"Math":{"src":"A"}},{"Text":" then the suffix must match "},{"Math":{"src":"C"}},{"Text":"."}]},{"Paragraph":[{"Text":"Together, these form the adjunction:"}]},{"Math":{"src":"D_A B ⊢ C quad <==> quad B ⊢ root(A, C)"}},{"Paragraph":[{"Text":"This is an instance of the "},{"EntryLink":{"id":"day-quotient","label":null,"body":[{"Text":"Day quotient"}]}},{"Text":" over the discrete monoidal category of strings."}]}]}}}]}}
