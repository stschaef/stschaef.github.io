{"format":"helia-content","version":1,"id":"category-of-elements","title":{"Inline":[{"Text":"Category of Elements"}]},"title_text":"Category of Elements","kind":"definition","taxon":null,"url":"category-of-elements.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","category-of-elements"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"Let "},{"Math":{"src":"P"}},{"Text":" be a presheaf on a "},{"EntryLink":{"id":"category","label":null,"body":[{"Text":"category"}]}},{"Text":" "},{"Math":{"src":"cal(C)"}},{"Text":". The "},{"Emph":[{"Text":"category of elements"}]},{"Text":" of "},{"Math":{"src":"P"}},{"Text":" is the "},{"EntryLink":{"id":"displayed-category","label":null,"body":[{"Text":"displayed category"}]}},{"Text":" over "},{"Math":{"src":"cal(C)"}},{"Text":" whose displayed objects over "},{"Math":{"src":"c"}},{"Text":" are the "},{"EntryLink":{"id":"element-of-presheaf","label":null,"body":[{"Text":"elements"}]}},{"Text":" "},{"Math":{"src":"p ∈ P c"}},{"Text":", and whose displayed morphisms over "},{"Math":{"src":"f : c -> d"}},{"Text":" from "},{"Math":{"src":"p"}},{"Text":" to "},{"Math":{"src":"q"}},{"Text":" are proofs that "},{"Math":{"src":"(P f)(q) = p"}},{"Text":"."}]},{"Paragraph":[{"Text":"Since "},{"Math":{"src":"P c"}},{"Text":" is a set, there is at most one displayed morphism over each "},{"Math":{"src":"f"}},{"Text":" between given elements: a morphism of elements is a morphism of "},{"Math":{"src":"cal(C)"}},{"Text":" that happens to carry "},{"Math":{"src":"q"}},{"Text":" back to "},{"Math":{"src":"p"}},{"Text":". Its "},{"EntryLink":{"id":"total-category","label":null,"body":[{"Text":"total category"}]}},{"Text":" is the classical category of elements "},{"Math":{"src":"∫ P"}},{"Text":", and a "},{"EntryLink":{"id":"universal-element","label":null,"body":[{"Text":"universal element"}]}},{"Text":" of "},{"Math":{"src":"P"}},{"Text":" is exactly a terminal object of "},{"Math":{"src":"∫ P"}},{"Text":"."}]}]}}}]}}
