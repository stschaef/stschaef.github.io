{"format":"helia-content","version":1,"id":"grammar-residual","title":{"Inline":[{"Text":"Grammar Residuals"}]},"title_text":"Grammar Residuals","kind":"definition","taxon":null,"url":"grammar-residual.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","grammar-residual"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"For "},{"EntryLink":{"id":"formal-grammar","label":null,"body":[{"Text":"formal grammars"}]}},{"Text":" "},{"Math":{"src":"A"}},{"Text":" and "},{"Math":{"src":"B"}},{"Text":", the "},{"Emph":[{"Text":"residual"}]},{"Text":" "},{"Math":{"src":"A ⊸ B"}},{"Text":" (sometimes called the lollipop or linear implication) is the right adjoint to the "},{"EntryLink":{"id":"grammar-tensor","label":null,"body":[{"Text":"grammar tensor"}]}},{"Text":" "},{"Math":{"src":"A ⊗ B"}},{"Text":". It describes strings that, when prefixed by a string matching "},{"Math":{"src":"A"}},{"Text":", will match "},{"Math":{"src":"B"}},{"Text":"."}]},{"Paragraph":[{"Text":"Formally, it is defined as:"}]},{"Math":{"src":"(A ⊸ B)(v) = Pi_u A(u) -> B(u dot.c v)"}},{"Paragraph":[{"Text":"Intuitively, a parse of "},{"Math":{"src":"A ⊸ B"}},{"Text":" at a string "},{"Math":{"src":"v"}},{"Text":" is a function that takes any prefix string "},{"Math":{"src":"u"}},{"Text":" and a parse of "},{"Math":{"src":"u"}},{"Text":" in "},{"Math":{"src":"A"}},{"Text":", and produces a parse of the full concatenated string "},{"Math":{"src":"u dot.c v"}},{"Text":" in "},{"Math":{"src":"B"}},{"Text":"."}]}]}}}]}}
