{"format":"helia-content","version":1,"id":"closed-monoidal-category","title":{"Inline":[{"Text":"Closed Monoidal Structure"}]},"title_text":"Closed Monoidal Structure","kind":"definition","taxon":null,"url":"closed-monoidal-category.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","closed-monoidal-category"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"A "},{"EntryLink":{"id":"monoidal-category","label":null,"body":[{"Text":"monoidal category"}]}},{"Text":" is "},{"Emph":[{"Text":"left closed"}]},{"Text":" if for each "},{"Math":{"src":"Y ∈ C"}},{"Text":", the functor "},{"Math":{"src":"- ⊗ Y : C -> C"}},{"Text":" has a right adjoint "},{"Math":{"src":"Y class(\"binary\", scripts(⊸)) - : C -> C"}},{"Text":" forming the left internal-hom out of "},{"Math":{"src":"Y"}},{"Text":"."}]},{"Paragraph":[{"Text":"That is, for all "},{"Math":{"src":"X, Y, Z"}},{"Text":", there is a natural isomorphism "},{"Math":{"src":"C[X ⊗ Y,\nZ] ≅ C[X, [Y, Z]]"}}]},{"Paragraph":[{"Text":"There is an obvious right-handed variant "},{"Math":{"src":"Y class(\"binary\", scripts(⟜)) -"}},{"Text":" that is right adjoint to "},{"Math":{"src":"Y ⊗ -"}},{"Text":"."}]},{"Paragraph":[{"Text":"If "},{"Math":{"src":"C"}},{"Text":" is both right and left closed, the monoidal category is simply called "},{"Emph":[{"Text":"closed"}]},{"Text":" (or perhaps "},{"Emph":[{"Text":"biclosed"}]},{"Text":")."}]}]}}}]}}
