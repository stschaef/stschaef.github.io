{"format":"helia-content","version":1,"id":"total-category","title":{"Inline":[{"Text":"Total category"}]},"title_text":"Total category","kind":"definition","taxon":null,"url":"total-category.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","total-category"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"The "},{"Emph":[{"Text":"total category"}]},{"Text":" "},{"Math":{"src":"∫ overline(cal(D))"}},{"Text":" of a "},{"EntryLink":{"id":"displayed-category","label":null,"body":[{"Text":"displayed category"}]}},{"Text":" "},{"Math":{"src":"overline(cal(D))"}},{"Text":" over "},{"Math":{"src":"cal(C)"}},{"Text":" collects the displayed data into a single category. Its objects are pairs of an object "},{"Math":{"src":"x"}},{"Text":" of "},{"Math":{"src":"cal(C)"}},{"Text":" with an object "},{"Math":{"src":"overline(x)"}},{"Text":" over it, and its morphisms "},{"Math":{"src":"lr(( x \\, overline(x) )) -> lr(( y \\, overline(y) ))"}},{"Text":" are pairs of a morphism "},{"Math":{"src":"f : x -> y"}},{"Text":" with a displayed morphism "},{"Math":{"src":"overline(f)"}},{"Text":" over "},{"Math":{"src":"f"}},{"Text":"."}]},{"Paragraph":[{"Text":"Projecting out the first components is a functor "},{"Math":{"src":"∫ overline(cal(D)) -> cal(C)"}},{"Text":". Constructions presented displayed — "},{"EntryLink":{"id":"algebras-displayed","label":null,"body":[{"Text":"algebras"}]}},{"Text":", "},{"EntryLink":{"id":"eilenberg-moore-displayed","label":null,"body":[{"Text":"Eilenberg–Moore categories"}]}},{"Text":" — get their "},{"Emph":[{"Text":"forgetful functor"}]},{"Text":" for free as this projection."}]}]}}}]}}
