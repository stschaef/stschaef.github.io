"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":10},{"t":"str","v":"doi:10.1109/cvpr42600.2020.01428"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":10},{"t":"str","v":"title:on translation invariance in cnns convolutional layers can exploit absolute spatial location|2020"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":11},{"t":"str","v":"title:mnist database of handwritten digits"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":12},{"t":"str","v":"title:learning multiple layers of features from tiny images|2012"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":13},{"t":"str","v":"arxiv:1412.6980"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":13},{"t":"str","v":"title:adam a method for stochastic optimization|2014"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":14},{"t":"str","v":"title:imagenet classification with deep convolutional neural networks|2012"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":15},{"t":"str","v":"arxiv:1710.09829"}]},{"relation":"cites-key","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"int","v":15},{"t":"str","v":"title:dynamic routing between capsules|2017"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"}]},{"relation":"import","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"bibtex"},{"t":"str","v":"@incollection{moutonStrideTranslationInvariance2020,\n title = {Stride and {{Translation Invariance}} in {{CNNs}}},\n author = {Mouton, Coenraad and Myburgh, Johannes C. and Davel, Marelie H.},\n date = {2020},\n doi = {10.1007/978-3-030-66151-9_17},\n url = {http://arxiv.org/abs/2103.10097},\n urldate = {2024-01-15},\n volume = {1342},\n pages = {267--281},\n keywords = {Computer Science - Machine Learning},\n abstract = {Convolutional Neural Networks have become the standard for image classification tasks, however, these architectures are not invariant to translations of the input image. This lack of invariance is attributed to the use of stride which ignores the sampling theorem, and fully connected layers which lack spatial reasoning. We show that stride can greatly benefit translation invariance given that it is combined with sufficient similarity between neighbouring pixels, a characteristic which we refer to as local homogeneity. We also observe that this characteristic is dataset-specific and dictates the relationship between pooling kernel size and stride required for translation invariance. Furthermore we find that a trade-off exists between generalization and translation invariance in the case of pooling kernel size, as larger kernel sizes lead to better invariance but poorer generalization. Finally we explore the efficacy of other solutions proposed, namely global average pooling, anti-aliasing, and data augmentation, both empirically and through the lens of local homogeneity.},\n eprintclass = {cs},\n eprinttype = {arXiv},\n eprint = {2103.10097},\n booktitle = {Artificial Intelligence Research (SACAIR 2020)},\n series = {Communications in Computer and Information Science}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"container"},{"t":"str","v":"Artificial Intelligence Research"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"doi"},{"t":"str","v":"10.1007/978-3-030-66151-9_17"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"entry-type"},{"t":"str","v":"chapter"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"eprint"},{"t":"str","v":"2103.10097"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"pages"},{"t":"str","v":"267–281"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"url"},{"t":"str","v":"http://arxiv.org/abs/2103.10097"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"volume"},{"t":"str","v":"1342"}]},{"relation":"meta","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"year"},{"t":"int","v":2020}]},{"relation":"path","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"entries/refs/moutonStrideTranslationInvariance2020/moutonStrideTranslationInvariance2020.hel"}]},{"relation":"reference","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"chapter"},{"t":"int","v":2020}]},{"relation":"reference-pdf","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"621cce6ce2bf89f1cb4e0be302a8a887faa5ab700f83fb50008529958ecd419f"}]},{"relation":"tag","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"machine-learning"}]},{"relation":"tag","args":[{"t":"entry","v":"moutonStrideTranslationInvariance2020"},{"t":"str","v":"machine-learning-verification"}]},{"relation":"title","args"