  <fr:mainmatter>
  <html:section>
  
  <html:div style="display: flex; flex-direction: column; align-items: center; justify-content: center">
    
  <html:span style="font-size: 2em">2-cells and natural transformations</html:span>

    <html:p><html:em>A 2-cell is a higher cell --- derived from the morphisms it fills.</html:em></html:p>
  </html:div>

</html:section>

  <html:section>
  
  <html:div style="text-align: center"><html:p><html:strong>A filled commutative square</html:strong></html:p> <fr:tex display="inline"><![CDATA[\phi  : g \circ  f \Rightarrow  k \circ  h]]></fr:tex></html:div>

  
  <html:div class="cd-anim" data-loop="true">
    
  <html:div class="cda-obj" data-id="A"><fr:tex display="inline"><![CDATA[A]]></fr:tex></html:div>

    
  <html:div class="cda-obj" data-id="B"><fr:tex display="inline"><![CDATA[B]]></fr:tex></html:div>

    
  <html:div class="cda-obj" data-id="C"><fr:tex display="inline"><![CDATA[C]]></fr:tex></html:div>

    
  <html:div class="cda-obj" data-id="D"><fr:tex display="inline"><![CDATA[D]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="f" data-from="A" data-to="B" data-curve="0"><fr:tex display="inline"><![CDATA[f]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="g" data-from="B" data-to="D" data-curve="0"><fr:tex display="inline"><![CDATA[g]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="h" data-from="A" data-to="C" data-curve="0"><fr:tex display="inline"><![CDATA[h]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="k" data-from="C" data-to="D" data-curve="0"><fr:tex display="inline"><![CDATA[k]]></fr:tex></html:div>

    
  <html:div class="cda-face" data-id="sq" data-verts="A,B,D,C"><fr:tex display="inline"><![CDATA[\phi ]]></fr:tex></html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="A" data-x="20" data-y="20" />

  <html:span class="cda-at" data-obj="B" data-x="80" data-y="20" />

  <html:span class="cda-at" data-obj="C" data-x="20" data-y="80" />

  <html:span class="cda-at" data-obj="D" data-x="80" data-y="80" />
</html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="A" data-x="20" data-y="22" />

  <html:span class="cda-at" data-obj="B" data-x="80" data-y="20" />

  <html:span class="cda-at" data-obj="C" data-x="24" data-y="80" />

  <html:span class="cda-at" data-obj="D" data-x="88" data-y="74" />
</html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="A" data-x="20" data-y="20" />

  <html:span class="cda-at" data-obj="B" data-x="80" data-y="20" />

  <html:span class="cda-at" data-obj="C" data-x="20" data-y="80" />

  <html:span class="cda-at" data-obj="D" data-x="80" data-y="80" />
</html:div>

  </html:div>

  
  <html:div style="text-align: center">
  <html:span style="font-size: 0.75em">the filling stays glued as the vertices move</html:span>
</html:div>

</html:section>

  <html:section>
  
  <html:div style="text-align: center"><html:p><html:strong>A natural transformation</html:strong></html:p> <fr:tex display="inline"><![CDATA[\alpha  : F \Rightarrow  G]]></fr:tex></html:div>

  
  <html:div class="cd-anim" data-loop="true">
    
  <html:div class="cda-obj" data-id="C"><fr:tex display="inline"><![CDATA[\mathcal  C]]></fr:tex></html:div>

    
  <html:div class="cda-obj" data-id="D"><fr:tex display="inline"><![CDATA[\mathcal  D]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="F" data-from="C" data-to="D" data-curve="-0.5"><fr:tex display="inline"><![CDATA[F]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="G" data-from="C" data-to="D" data-curve="0.5"><fr:tex display="inline"><![CDATA[G]]></fr:tex></html:div>

    
  <html:div class="cda-2cell" data-id="al" data-src="F" data-tgt="G"><fr:tex display="inline"><![CDATA[\alpha ]]></fr:tex></html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="C" data-x="24" data-y="50" />

  <html:span class="cda-at" data-obj="D" data-x="76" data-y="50" />
</html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="C" data-x="24" data-y="38" />

  <html:span class="cda-at" data-obj="D" data-x="78" data-y="64" />
</html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="C" data-x="24" data-y="50" />

  <html:span class="cda-at" data-obj="D" data-x="76" data-y="50" />
</html:div>

  </html:div>

  
  <html:div style="text-align: center">
  <html:span style="font-size: 0.75em">transparent lens between <fr:tex display="inline"><![CDATA[F]]></fr:tex> and <fr:tex display="inline"><![CDATA[G]]></fr:tex>; the double arrow and label
     track the two functors</html:span>
</html:div>

</html:section>

  <html:section>
  
  <html:div style="text-align: center"><html:p><html:strong>Stepped</html:strong></html:p> 
  <html:span style="font-size: 0.75em">(press space / down)</html:span>
</html:div>

  
  <html:div class="cd-anim" data-steps="true">
    
  <html:div class="cda-obj" data-id="A"><fr:tex display="inline"><![CDATA[A]]></fr:tex></html:div>

    
  <html:div class="cda-obj" data-id="B"><fr:tex display="inline"><![CDATA[B]]></fr:tex></html:div>

    
  <html:div class="cda-obj" data-id="C"><fr:tex display="inline"><![CDATA[C]]></fr:tex></html:div>

    
  <html:div class="cda-obj" data-id="D"><fr:tex display="inline"><![CDATA[D]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="f" data-from="A" data-to="B" data-curve="0"><fr:tex display="inline"><![CDATA[f]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="g" data-from="B" data-to="D" data-curve="0"><fr:tex display="inline"><![CDATA[g]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="h" data-from="A" data-to="C" data-curve="0"><fr:tex display="inline"><![CDATA[h]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="k" data-from="C" data-to="D" data-curve="0"><fr:tex display="inline"><![CDATA[k]]></fr:tex></html:div>

    
  <html:div class="cda-edge" data-id="d" data-from="A" data-to="D" data-curve="0.3"><fr:tex display="inline"><![CDATA[d]]></fr:tex></html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="A" data-x="20" data-y="20" />

  <html:span class="cda-at" data-obj="B" data-x="80" data-y="20" />

  <html:span class="cda-at" data-obj="C" data-x="20" data-y="80" />

  <html:span class="cda-at" data-obj="D" data-x="80" data-y="80" />
</html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="A" data-x="20" data-y="20" />

  <html:span class="cda-at" data-obj="B" data-x="80" data-y="20" />

  <html:span class="cda-at" data-obj="C" data-x="50" data-y="82" />

  <html:span class="cda-at" data-obj="D" data-x="80" data-y="52" />
</html:div>

    
  <html:div class="cda-kf">
  <html:span class="cda-at" data-obj="A" data-x="18" data-y="18" />

  <html:span class="cda-at" data-obj="B" data-x="82" data-y="34" />

  <html:span class="cda-at" data-obj="C" data-x="34" data-y="82" />

  <html:span class="cda-at" data-obj="D" data-x="64" data-y="64" />
</html:div>

  </html:div>

  
  <html:div style="text-align: center">
  <html:span style="font-size: 0.75em">each keyframe waits for a user event --- stepping is vertical</html:span>
</html:div>

</html:section>

  <html:section>
  
  <html:div style="display: flex; flex-direction: column; align-items: center; justify-content: center">
    <html:p><html:span style="font-size: 1.4em">2-cells are just more derived cells.</html:span></html:p>
    <html:p><html:code><![CDATA[\cdface{id}{A,B,D,C}{label}]]></html:code> fills a region bounded
       by a vertex cycle; <html:code><![CDATA[\cd2cell{id}{F}{G}{label}]]></html:code> draws a
       transparent lens + double arrow between two parallel morphisms. Both follow
       their boundary for free.</html:p>
    <html:p><html:span style="font-size: 0.75em"><html:code><![CDATA[\cdanimSteps]]></html:code> makes the keyframes advance on
       user events instead of autoplaying.</html:span></html:p>
  </html:div>

</html:section>
