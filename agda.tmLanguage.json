{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Agda",
  "scopeName": "source.agda",
  "fileTypes": ["agda", "lagda"],
  "patterns": [
    { "include": "#pragma" },
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#hole" },
    { "include": "#hole_open" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#keyword_top" },
    { "include": "#keyword_decl" },
    { "include": "#keyword_control" },
    { "include": "#builtin_sort" },
    { "include": "#number" },
    { "include": "#operator_arrow" },
    { "include": "#operator_lambda" },
    { "include": "#operator_forall" },
    { "include": "#operator_equiv" },
    { "include": "#operator_misc" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "pragma": {
      "begin": "\\{-#",
      "end": "#-\\}",
      "name": "meta.preprocessor.agda",
      "patterns": [
        {
          "match": "\\b(BUILTIN|FOREIGN|COMPILE|TERMINATING|NON_TERMINATING|NO_POSITIVITY_CHECK|NO_UNIVERSE_CHECK|NO_TERMINATION_CHECK|INLINE|NOINLINE|REWRITE|STATIC|INJECTIVE|OPTIONS|DISPLAY|ETA|WARNING_ON_USAGE|WARNING_ON_IMPORT|POLARITY|MEASURE|CATCHALL|IMPOSSIBLE)\\b",
          "name": "keyword.other.pragma.agda"
        }
      ]
    },
    "block_comment": {
      "begin": "\\{-",
      "end": "-\\}",
      "name": "comment.block.agda",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "match": "--.*$",
      "name": "comment.line.double-dash.agda"
    },
    "hole_open": {
      "begin": "\\{!",
      "end": "!\\}",
      "name": "meta.hole.agda",
      "contentName": "comment.block.documentation.agda"
    },
    "hole": {
      "match": "(?<![\\w\\?])\\?(?![\\w\\?])",
      "name": "keyword.other.hole.agda"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.agda",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.agda" }
      ]
    },
    "char": {
      "match": "'(\\\\.|[^'\\\\])'",
      "name": "string.quoted.single.agda"
    },
    "keyword_top": {
      "match": "\\b(module|import|open|using|hiding|renaming|public|private|abstract|instance|macro|primitive|infix|infixl|infixr|syntax|pattern|overlap|tactic|variable)\\b",
      "name": "keyword.other.agda"
    },
    "keyword_decl": {
      "match": "\\b(data|codata|record|field|constructor|inductive|coinductive|postulate|mutual)\\b",
      "name": "storage.type.agda"
    },
    "keyword_control": {
      "match": "\\b(where|with|rewrite|let|in|do|using|hiding|forall|case|of)\\b",
      "name": "keyword.control.agda"
    },
    "builtin_sort": {
      "match": "\\b(Set|Type|Prop|Setω|Setω₁|Level|lzero|lsuc|⊤|⊥)\\b",
      "name": "support.type.agda"
    },
    "number": {
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.agda"
    },
    "operator_arrow": {
      "match": "(→|->|⇒|⇨|⊸)",
      "name": "keyword.operator.arrow.agda"
    },
    "operator_lambda": {
      "match": "(λ|\\\\)(?=[\\s\\w\\(])",
      "name": "keyword.operator.lambda.agda"
    },
    "operator_forall": {
      "match": "(∀|∃)",
      "name": "keyword.operator.quantifier.agda"
    },
    "operator_equiv": {
      "match": "(≡|≃|≅|≈|≢)",
      "name": "keyword.operator.equality.agda"
    },
    "operator_misc": {
      "match": "(∷|∘|∙|⊎|×|⊔|⊓|≤|≥|⊑|⊒|⊢|⊣|⟦|⟧|⟨|⟩|·)",
      "name": "keyword.operator.agda"
    },
    "punctuation": {
      "match": "(:|=|\\||;|\\.\\.|\\.)",
      "name": "punctuation.separator.agda"
    }
  }
}
