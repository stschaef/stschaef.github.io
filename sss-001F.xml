    <fr:title text="Star Continuity">Star Continuity</fr:title>
    <fr:taxon>Definition</fr:taxon>
  </fr:frontmatter>
  <fr:mainmatter>
    <fr:p>A Kleene Algebra is <fr:em>star continuous</fr:em> if for all <fr:tex display="inline"><![CDATA[x,y,z]]></fr:tex>
<fr:tex display="block"><![CDATA[\mathrm {sup}{\mathopen {}\left (x\right )\mathclose {}}_{n \geq  0} = x {y}^{*} z]]></fr:tex></fr:p>
  </fr:mainmatter>
