{"format":"helia-content","version":1,"id":"coalgebras-displayed","title":{"Inline":[{"Text":"Coalgebras as a displayed category"}]},"title_text":"Coalgebras as a displayed category","kind":"note","taxon":null,"url":"coalgebras-displayed.html","content":{"Block":[{"Group":{"role":"entry","attrs":[["entry","coalgebras-displayed"],["kind","note"]],"body":{"Block":[{"Paragraph":[{"Text":"Fix an endofunctor "},{"Math":{"src":"F : cal(C) -> cal(C)"}},{"Text":". Coalgebras require no new construction: a coalgebra is an "},{"EntryLink":{"id":"algebras-displayed","label":null,"body":[{"Text":"algebra"}]}},{"Text":" in the opposite category. Define"}]},{"Math":{"src":"\"CoalgStr\" lr(( F )) = \"AlgStr\" lr(( F^(\"op\") )) ,"}},{"Paragraph":[{"Text":"a displayed category over "},{"Math":{"src":"cal(C)^(\"op\")"}},{"Text":", where "},{"Math":{"src":"F^(\"op\") : cal(C)^(\"op\") -> cal(C)^(\"op\")"}},{"Text":" is "},{"Math":{"src":"F"}},{"Text":" acting on the opposite category."}]},{"Paragraph":[{"Text":"Concretely, over an object "},{"Math":{"src":"x"}},{"Text":" a displayed object is a structure map"}]},{"Math":{"src":"gamma ∈ cal(C) lr(( x \\, F x )) ."}},{"Paragraph":[{"Text":"The category of coalgebras is the opposite of the "},{"EntryLink":{"id":"total-category","label":null,"body":[{"Text":"total category"}]}},{"Text":":"}]},{"Math":{"src":"\"Coalg\" lr(( F )) = lr(( ∫ \"CoalgStr\" lr(( F )) ))^(\"op\") ."}},{"Paragraph":[{"Text":"The outer opposite returns morphisms to the direction of "},{"Math":{"src":"cal(C)"}},{"Text":": a morphism "},{"Math":{"src":"lr(( x \\, gamma )) -> lr(( y \\, delta ))"}},{"Text":" is a map "},{"Math":{"src":"f : x -> y"}},{"Text":" with"}]},{"Math":{"src":"f ⋆ delta = gamma ⋆ F f ."}}]}}}]}}
