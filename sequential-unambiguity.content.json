{"format":"helia-content","version":1,"id":"sequential-unambiguity","title":{"Inline":[{"Text":"Sequential Unambiguity"}]},"title_text":"Sequential Unambiguity","kind":"definition","taxon":null,"url":"sequential-unambiguity.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","sequential-unambiguity"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"Grammars "},{"Math":{"src":"A"}},{"Text":" and "},{"Math":{"src":"B"}},{"Text":" are "},{"Emph":[{"Text":"sequentially unambiguous"}]},{"Text":" if the "},{"EntryLink":{"id":"followlast-set","label":null,"body":[{"Text":"followlast set"}]}},{"Text":" of "},{"Math":{"src":"A"}},{"Text":" is disjoint from the "},{"EntryLink":{"id":"first-set","label":null,"body":[{"Text":"first set"}]}},{"Text":" of "},{"Math":{"src":"B"}},{"Text":"."}]},{"Math":{"src":"sans(\"FLast\")(A) ∩ sans(\"First\")(B) = ∅"}},{"Paragraph":[{"Text":"We can understand this intuitively by characterizing the behavior of a left-to-right parser of "},{"Math":{"src":"A ⊗ B"}},{"Text":". First it searches for a parse of "},{"Math":{"src":"A"}},{"Text":", then upon finding a character that is not in "},{"Math":{"src":"sans(\"FLast\")(A)"}},{"Text":" it may begin trying search for "},{"Math":{"src":"B"}},{"Text":"."}]},{"Paragraph":[{"Text":"That is, there is a unique boundary between the "},{"Math":{"src":"A"}},{"Text":"-parse and the "},{"Math":{"src":"B"}},{"Text":"-parse."}]}]}}}]}}
