            <fr:addr type="user">sss-0014</fr:addr>
            <fr:route>sss-0014.xml</fr:route>
            <fr:title text="Nullable Grammar">Nullable Grammar</fr:title>
            <fr:taxon>Definition</fr:taxon>
          </fr:frontmatter>
          <fr:mainmatter>
            <fr:p>A grammar <fr:tex display="inline"><![CDATA[A]]></fr:tex> is nullable if the empty string belongs to the language of <fr:tex display="inline"><![CDATA[A]]></fr:tex>.</fr:p>
          </fr:mainmatter>
