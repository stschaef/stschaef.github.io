{"format":"helia-content","version":1,"id":"terminal-object","title":{"Inline":[{"Text":"Terminal Object"}]},"title_text":"Terminal Object","kind":"definition","taxon":null,"url":"terminal-object.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","terminal-object"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"An object "},{"Math":{"src":"c"}},{"Text":" in a category "},{"Math":{"src":"cal(C)"}},{"Text":" is "},{"Emph":[{"Text":"terminal"}]},{"Text":" if there is a unique morphism from any other object into it."}]},{"Paragraph":[{"Text":"Because terminal objects are unique up to unique isomorphism (as are all universal objects) we often just write "},{"Math":{"src":"⊤"}},{"Text":" to refer to the terminal object. Likewise, "},{"Math":{"src":"! : d -> ⊤"}},{"Text":" refers to the unique morphism into "},{"Math":{"src":"⊤"}},{"Text":"."}]}]}}}]}}
