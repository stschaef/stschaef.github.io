"v":"doi:10.1007/978-3-642-17164-2_25"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":26},{"t":"str","v":"title:a certified implementation of ml with structural polymorphism|2010"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":27},{"t":"str","v":"title:hol4 http hol sourceforge net"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":28},{"t":"str","v":"doi:10.1007/978-3-319-03545-1_5"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":28},{"t":"str","v":"title:proof pearl a verified bignum implementation in x86 64 machine code|2013"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":29},{"t":"str","v":"doi:10.1007/978-3-642-22863-6_20"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":29},{"t":"str","v":"title:a verified runtime for a verified theorem prover|2011"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":30},{"t":"str","v":"doi:10.1007/978-3-540-78739-6_1"}]},{"relation":"cites-key","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"int","v":30},{"t":"str","v":"title:a sound semantics for ocaml light|2008"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"kumar_cakeml_2014"}]},{"relation":"import","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"bibtex"},{"t":"str","v":"@inproceedings{kumar_cakeml_2014,\n title = {{CakeML}: a verified implementation of {ML}},\n author = {Kumar, Ramana and Myreen, Magnus O. and Norrish, Michael and Owens, Scott},\n year = {2014},\n isbn = {978-1-4503-2544-8},\n doi = {10.1145/2535838.2535841},\n url = {https://dl.acm.org/doi/10.1145/2535838.2535841},\n urldate = {2024-04-22},\n booktitle = {Proceedings of the 41st {ACM} {SIGPLAN}-{SIGACT} {Symposium} on {Principles} of {Programming} {Languages}},\n pages = {179--191},\n publisher = {ACM},\n address = {San Diego California USA},\n month = {January},\n language = {en},\n abstract = {We have developed and mechanically verified an ML system called CakeML, which supports a substantial subset of Standard ML. CakeML is implemented as an interactive read-eval-print loop (REPL) in x86-64 machine code. Our correctness theorem ensures that this REPL implementation prints only those results permitted by the semantics of CakeML. Our verification effort touches on a breadth of topics including lexing, parsing, type checking, incremental and dynamic compilation, garbage collection, arbitraryprecision arithmetic, and compiler bootstrapping.},\n shorttitle = {{CakeML}}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"container"},{"t":"str","v":"Proceedings of the 41st ACM SIGPLAN-SIGACT Symposium on Principles of Programming Languages"}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"doi"},{"t":"str","v":"10.1145/2535838.2535841"}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"entry-type"},{"t":"str","v":"inproceedings"}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"month"},{"t":"int","v":1}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"pages"},{"t":"str","v":"179--191"}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"pdf-url"},{"t":"str","v":"https://dl.acm.org/doi/pdf/10.1145/2535838.2535841"}]},{"relation":"meta","args":[{"t":"entry","v":"kumar_cakeml_2014"},{"t":"str","v":"pldb"},{"t":"str","v":"https://pldb.kirancodes.me/p/conf/popl/KumarMNO14