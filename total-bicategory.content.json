{"format":"helia-content","version":1,"id":"total-bicategory","title":{"Inline":[{"Text":"Total Bicategory"}]},"title_text":"Total Bicategory","kind":"definition","taxon":null,"url":"total-bicategory.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","total-bicategory"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"The "},{"Emph":[{"Text":"total bicategory"}]},{"Text":" "},{"Math":{"src":"∫ overline(cal(K))"}},{"Text":" of a displayed bicategory "},{"Math":{"src":"overline(cal(K))"}},{"Text":" over "},{"Math":{"src":"cal(K)"}},{"Text":" packages the base and the displayed data together, one dimension up from the "},{"EntryLink":{"id":"total-category","label":null,"body":[{"Text":"total category"}]}},{"Text":" of a displayed category."}]},{"List":{"marker":null,"tight":true,"items":[{"Inline":[{"Text":"Its 0-cells are pairs "},{"Math":{"src":"(x, overline(x))"}},{"Text":" of a 0-cell of "},{"Math":{"src":"cal(K)"}},{"Text":" and a displayed 0-cell over it."}]},{"Inline":[{"Text":"Its hom-category from "},{"Math":{"src":"(x, overline(x))"}},{"Text":" to "},{"Math":{"src":"(y, overline(y))"}},{"Text":" is the total category of the displayed hom-category "},{"Math":{"src":"overline(cal(K) (x, y))"}},{"Text":". So a 1-cell is a pair "},{"Math":{"src":"(f,\n  overline(f))"}},{"Text":" and a 2-cell is a pair "},{"Math":{"src":"(alpha, overline(alpha))"}},{"Text":"."}]},{"Inline":[{"Text":"Identities, composition, unitors and associator are pairs of the base structure and the displayed structure over it, and the triangle and pentagon hold because they hold in the base and, over that, in the displayed bicategory."}]}]}},{"Paragraph":[{"Text":"Projecting to first components is a "},{"EntryLink":{"id":"pseudofunctor","label":null,"body":[{"Text":"pseudofunctor"}]}},{"Text":" "},{"Math":{"src":"pi : ∫ overline(cal(K)) ->\ncal(K)"}},{"Text":" whose unit and composition comparisons are identity 2-cells."}]}]}}}]}}
