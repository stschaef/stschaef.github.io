s, problems, and solutions are also presented.},\n shorttitle = {Programming {Techniques}},\n issn = {0001-0782, 1557-7317}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"container"},{"t":"str","v":"Communications of the ACM"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"doi"},{"t":"str","v":"10.1145/363347.363387"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"entry-type"},{"t":"str","v":"article"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"month"},{"t":"int","v":6}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"number"},{"t":"str","v":"6"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"pages"},{"t":"str","v":"419--422"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"url"},{"t":"str","v":"https://dl.acm.org/doi/10.1145/363347.363387"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"venue"},{"t":"str","v":"cacm"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"volume"},{"t":"str","v":"11"}]},{"relation":"meta","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"year"},{"t":"int","v":1968}]},{"relation":"path","args":[{"t":"entry","v":"thompsonProgrammingTechniquesRegular1968"},{"t":"str","v":"entries/refs/thompsonProgrammingTechniquesRegular1968/thompsonProgrammingTechniquesRegular1968.hel"}]},{"relation":"reference","args":[{"t":"entry","v":"thompsonProgramming