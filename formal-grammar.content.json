{"format":"helia-content","version":1,"id":"formal-grammar","title":{"Inline":[{"Text":"Formal Grammar"}]},"title_text":"Formal Grammar","kind":"definition","taxon":null,"url":"formal-grammar.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","formal-grammar"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"For an alphabet "},{"Math":{"src":"Sigma"}},{"Text":", let "},{"Math":{"src":"Sigma^*"}},{"Text":" be the free monoid of strings over "},{"Math":{"src":"Sigma"}},{"Text":". A "},{"Emph":[{"Text":"formal grammar"}]},{"Text":" "},{"Math":{"src":"A"}},{"Text":" is a family of types indexed by strings:"}]},{"Math":{"src":"A :\nSigma^* -> sans(\"Type\")"}},{"Paragraph":[{"Text":"This definition views formal grammars directly as indexed families of types over strings (which equivalently form presheaves on the discrete category of strings). This view forms the central notion of the "},{"EntryLink":{"id":"dependent-lambek-calculus","label":null,"body":[{"Text":"Dependent Lambek Calculus"}]}},{"Text":". For a given string "},{"Math":{"src":"w"}},{"Text":", the type "},{"Math":{"src":"A(w)"}},{"Text":" represents the type of all valid parse trees for "},{"Math":{"src":"w"}},{"Text":" according to the grammar "},{"Math":{"src":"A"}},{"Text":". If the grammar cannot parse "},{"Math":{"src":"w"}},{"Text":", then "},{"Math":{"src":"A(w)"}},{"Text":" is the empty type."}]}]}}}]}}
