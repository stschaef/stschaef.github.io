tUsingRefinementguided"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"maSiftUsingRefinementguided"}]},{"relation":"import","args":[{"t":"entry","v":"maSiftUsingRefinementguided"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"maSiftUsingRefinementguided"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"maSiftUsingRefinementguided"},{"t":"str","v":"bibtex"},{"t":"str","v":"@inproceedings{maSiftUsingRefinementguided,\n title = {Sift: {{Using Refinement-guided Automation}} to {{Verify Complex Distributed Systems}}},\n author = {Ma, Haojun and Ahmad, Hammad and Goel, Aman and Goldweber, Eli and Jeannin, Jean-Baptiste and Kapritsos, Manos and Kasikci, Baris},\n date = {2022},\n langid = {english},\n abstract = {Distributed systems are hard to design and implement correctly. Recent work has tried to use formal verification techniques to provide rigorous correctness guarantees. These works present a hard choice, though. One must either opt for the power of refinement-based approaches like IronFleet and Verdi, at the cost of large amounts of manual effort; or choose the more automated approach of I4, IC3PO, SWISS and DistAI which give up the ability to prove refinement and the power and scalability that come with it.},\n booktitle = {2022 USENIX Annual Technical Conference (USENIX ATC 22)},\n publisher = {USENIX Association}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"maSiftUsingRefinementguided"},{"t":"str","v":"container"},{"t":"str","v":"2022 USENIX Annual Technical Conference (USENIX ATC 22)"}]},{"relation":"meta","args":[{"t":"entry","v":"maSiftUsingRefinementguided"},{"t":"str","v":"entry-type"},{"t":"str","v":"inproceedings"}]},{"relation":"meta","args":[{"t":"entry","v":"maSiftUsingRefinementguided"},{"t":"str","v":"publisher"},{"t":"str","v":"USENIX Association"}]},{"relation":"meta","args":[{"t":"entry","v":"maSiftUsingRefinementguided"},{"t":"st