{"format":"helia-content","version":1,"id":"nominal-set","title":{"Inline":[{"Text":"Nominal Sets"}]},"title_text":"Nominal Sets","kind":"definition","taxon":null,"url":"nominal-set.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","nominal-set"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"Fix a countably infinite set of names "},{"Math":{"src":"bb(A)"}},{"Text":". A "},{"Emph":[{"Text":"nominal set"}]},{"Text":" is a set "},{"Math":{"src":"X"}},{"Text":" equipped with an action by the group of finite permutations "},{"Math":{"src":"sans(\"Perm\")(bb(A))"}},{"Text":", such that every element "},{"Math":{"src":"x in X"}},{"Text":" has a finite "},{"Emph":[{"Text":"support"}]},{"Text":"."}]},{"Paragraph":[{"Text":"A finite set of names "},{"Math":{"src":"S subset.eq bb(A)"}},{"Text":" supports "},{"Math":{"src":"x"}},{"Text":" if any permutation fixing "},{"Math":{"src":"S"}},{"Text":" pointwise also fixes "},{"Math":{"src":"x"}},{"Text":". The intersection of all supports for "},{"Math":{"src":"x"}},{"Text":" is called the least support, denoted "},{"Math":{"src":"sans(\"supp\")(x)"}},{"Text":"."}]},{"Paragraph":[{"Text":"The category of nominal sets is equivalent to the "},{"EntryLink":{"id":"schanuel-topos","label":null,"body":[{"Text":"Schanuel topos"}]}},{"Text":". Under this equivalence, a nominal set "},{"Math":{"src":"X"}},{"Text":" corresponds to a functor "},{"Math":{"src":"bb(I) -> bold(\"Set\")"}},{"Text":", where "},{"Math":{"src":"bb(I)"}},{"Text":" is the category of finite sets and injections, given by mapping a finite set of names "},{"Math":{"src":"t"}},{"Text":" to the set of elements supported by "},{"Math":{"src":"t"}},{"Text":":"}]},{"Math":{"src":"X(t) = { x in X mid(|) sans(\"supp\")(x) subset.eq t }"}}]}}}]}}
