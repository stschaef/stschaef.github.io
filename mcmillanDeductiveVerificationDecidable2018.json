},{"relation":"cites-key","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"int","v":38},{"t":"str","v":"title:ivy tool website|2018"}]},{"relation":"cites-key","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"int","v":39},{"t":"str","v":"title:techniques for program verification|1980"}]},{"relation":"cites-key","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"int","v":40},{"t":"str","v":"title:in search of an understandable consensus algorithm|2014"}]},{"relation":"cites-key","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"int","v":41},{"t":"str","v":"title:temporal prophecy for proving temporal properties of infinite state systems"}]},{"relation":"cites-key","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"int","v":42},{"t":"str","v":"arxiv:1710.07191"}]},{"relation":"cites-key","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"int","v":42},{"t":"str","v":"title:paxos made epr decidable reasoning about distributed protocols arxiv version|2017"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"}]},{"relation":"import","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"bibtex"},{"t":"str","v":"@incollection{mcmillanDeductiveVerificationDecidable2018,\n title = {Deductive {{Verification}} in {{Decidable Fragments}} with {{Ivy}}},\n author = {McMillan, Kenneth L. and Padon, Oded},\n date = {2018},\n isbn = {978-3-319-99724-7 978-3-319-99725-4},\n doi = {10.1007/978-3-319-99725-4_4},\n url = {http://link.springer.com/10.1007/978-3-319-99725-4_4},\n urldate = {2023-02-07},\n booktitle = {Static {{Analysis}}},\n editor = {Podelski, Andreas},\n volume = {11002},\n pages = {43--55},\n publisher = {Springer International Publishing},\n langid = {english},\n abstract = {This paper surveys the work to date on Ivy, a language and a tool for the formal specification and verification of distributed systems. Ivy supports deductive verification using automated provers, model checking, automated testing, manual theorem proving and generation of executable code. In order to achieve greater verification productivity, a key design goal for Ivy is to allow the engineer to apply automated provers in the realm in which their performance is relatively predictable, stable and transparent. In particular Ivy focuses on the use of decidable fragments of first-order logic. We consider the rationale or Ivy’s design, the various capabilities of the tool, as well as case studies and applications.},\n location = {Cham}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"container"},{"t":"str","v":"Static Analysis"}]},{"relation":"meta","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"doi"},{"t":"str","v":"10.1007/978-3-319-99725-4_4"}]},{"relation":"meta","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"entry-type"},{"t":"str","v":"chapter"}]},{"relation":"meta","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"pages"},{"t":"str","v":"43--55"}]},{"relation":"meta","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"publisher"},{"t":"str","v":"Springer International Publishing"}]},{"relation":"meta","args":[{"t":"entry","v":"mcmillanDeductiveVerificationDecidable2018"},{"t":"str","v":"url"},{"t":"str","v":"http://link.springer.