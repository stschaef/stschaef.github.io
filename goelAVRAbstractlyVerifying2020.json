ion to automatically perform scalable model checking by combining a novel syntax-guided abstraction-refinement technique with a word-level implementation of the IC3 algorithm. AVR provides independently-verifiable certificates that offer provable assurance and are easy to relate to the word-level system. Moreover, proof certificates can be further used in innovative ways to extract key design information and are useful in a growing number of applications.},\n location = {Cham},\n shorttitle = {{{AVR}}}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"container"},{"t":"str","v":"Tools and Algorithms for the Construction and Analysis of Systems"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"doi"},{"t":"str","v":"10.1007/978-3-030-45190-5_23"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"entry-type"},{"t":"str","v":"chapter"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"pages"},{"t":"str","v":"413--422"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"pdf-url"},{"t":"str","v":"https://link.springer.com/content/pdf/10.1007%2F978-3-030-45190-5_23.pdf"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"pldb"},{"t":"str","v":"https://pldb.kirancodes.me/p/conf/tacas/GoelS20"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"publisher"},{"t":"str","v":"Springer International Publishing"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"url"},{"t":"str","v":"http://link.springer.com/10.1007/978-3-030-45190-5_23"}]},{"relation":"meta","args":[{"t":"entry","v":"goelAVRAbstractlyVerifying2020"},{"t":"str","v":"venue"},{"t":"str","v":"tacas"}]},{"relation":"meta","args":[{"t":"entry","v":"goelA