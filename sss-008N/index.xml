    <fr:title text="Capture Prose shortcut">Capture Prose shortcut</fr:title>
  </fr:frontmatter>
  <fr:mainmatter>
    <html:p>Standalone iOS shortcut: prompts for a multi-line blurb, runs the shared tag picker, and POSTs <html:code>blurb</html:code>+<html:code>tags</html:code> form-encoded to <html:code>/capture</html:code>. Server stamps it with the <html:code>prose</html:code> tag.</html:p>
    <html:p>Generated by <html:code>build_prose(use_dictation=False)</html:code> in <html:code>~/forest/utils/gen-capture-shortcuts.py</html:code>:</html:p>
    <html:pre><![CDATA[def build_prose(use_dictation=False):
    input_uuid = uid()
    if use_dictation:
        input_action = dictate(uuid_=input_uuid)
        input_output = "Dictated Text"
    else:
        input_action = ask(
            "Blurb?", multiline=True, default="", uuid_=input_uuid
        )
        input_output = "Provided Input"
    download_uuid = uid()
    actions = [
        input_action,
        set_var("Blurb", source=action_output_ref(input_uuid, input_output)),
        *tag_picker_block(),
        download_url_json(
            ENDPOINT,
            [("blurb", tok_var_ref("Blurb")), ("tags", tok_var_ref("TagsCSV"))],
            uuid_=download_uuid,
        ),
        *trailing_notify(download_uuid),
    ]
    return top_level(actions)]]></html:pre>
  </fr:mainmatter>
