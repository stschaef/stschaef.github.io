    <fr:meta name="bibtex"><![CDATA[@article{barr1995nonsymmetric,
 title = {Nonsymmetric *-autonomous categories},
 author = {Barr, Michael},
 year = {1995},
 journal = {Theoretical Computer Science},
 volume = {139},
 number = {1--2},
 pages = {115--130},
 doi = {10.1016/0304-3975(94)00100-W},
 url = {https://doi.org/10.1016/0304-3975(94)00100-W},
 publisher = {Elsevier},
 abstract = {This paper develops a theory of *-autonomous categories without the assumption of a symmetric tensor product. Two closed structures, left and right implication, replace the single hom-functor of the symmetric case. The Chu construction is generalised, producing nonsymmetric *-autonomous categories from biclosed monoidal categories with a dualising object.}
}]]></fr:meta>
