70"},{"t":"int","v":4},{"t":"str","v":"doi:10.1007/bf01946814"}]},{"relation":"cites-key","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"int","v":4},{"t":"str","v":"title:notes on top down languages|1969"}]},{"relation":"cites-key","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"int","v":5},{"t":"str","v":"doi:10.1145/321466.321477"}]},{"relation":"cites-key","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"int","v":5},{"t":"str","v":"title:syntax directed transductions|1968"}]},{"relation":"cites-key","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"int","v":6},{"t":"str","v":"title:automatic syntactic analysis and the pushdown store|1961"}]},{"relation":"cites-key","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"int","v":7},{"t":"str","v":"title:structural equivalence of ll k grammars|1968"}]},{"relation":"cites-key","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"int","v":8},{"t":"str","v":"title:computability and unsolvability|1958"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"rosenkrantz_properties_1970"}]},{"relation":"import","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"bibtex"},{"t":"str","v":"@article{rosenkrantz_properties_1970,\n title = {Properties of deterministic top-down grammars},\n author = {Rosenkrantz, D. J. and Stearns, R. E.},\n year = {1970},\n doi = {10.1016/S0019-9958(70)90446-8},\n url = {https://www.sciencedirect.com/science/article/pii/S0019995870904468},\n urldate = {2024-11-14},\n journal = {Information and Control},\n volume = {17},\n number = {3},\n pages = {226--256},\n month = {October},\n abstract = {The class of context-free grammars that can be deterministically parsed in a top down manner with a fixed amount of look-ahead is investigated. These grammars, called LL(k) grammars where k is the amount of look-ahead are defined and a procedure is given for determining if a context-free grammar is LL(k) for a given value of k. A procedure is given for eliminating the ε-rules from an LL(k) grammar at the cost of increasing k by 1. There exist cases in which this increase is inevitable. A procedure is given for obtaining a deterministic push-down machine to recognize a given LL(k) grammar and it is shown that the equivalence problem is decidable for LL(k) grammars. Additional properties are also given.},\n issn = {0019-9958}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"container"},{"t":"str","v":"Information and Control"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"doi"},{"t":"str","v":"10.1016/s0019-9958(70)90446-8"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"entry-type"},{"t":"str","v":"article"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"month"},{"t":"int","v":10}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"number"},{"t":"str","v":"3"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"pages"},{"t":"str","v":"226--256"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"url"},{"t":"str","v":"https://www.sciencedirect.com/science/article/pii/S0019995870904468"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"venue"},{"t":"str","v":"iandc"}]},{"relation":"meta","args":[{"t":"entry","v":"rosenkrantz_properties_1970"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]}