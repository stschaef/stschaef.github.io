                <fr:addr type="user">sss-0003</fr:addr>
                <fr:route>sss-0003.xml</fr:route>
                <fr:title text="Sequents in the Syntactic Calculus">Sequents in the Syntactic Calculus</fr:title>
                <fr:taxon>Definition</fr:taxon>
              </fr:frontmatter>
              <fr:mainmatter>
                <fr:p>Define sequents <fr:tex display="inline"><![CDATA[x_1 , x_2 , \dots  , x_n \to  y]]></fr:tex> to stand for <fr:tex display="inline"><![CDATA[( \dots  ((x_1 x_2) x_3) \dots  x_n) \to  y]]></fr:tex>

<fr:ul><fr:li><fr:tex display="inline"><![CDATA[x \to  x]]></fr:tex></fr:li>
  <fr:li>if <fr:tex display="inline"><![CDATA[T , y \to  x]]></fr:tex> then <fr:tex display="inline"><![CDATA[T \to  x/y]]></fr:tex></fr:li>
  <fr:li>if <fr:tex display="inline"><![CDATA[y , T \to  x]]></fr:tex> then <fr:tex display="inline"><![CDATA[T \to  y \backslash  x]]></fr:tex></fr:li>
  <fr:li>if <fr:tex display="inline"><![CDATA[T \to  y]]></fr:tex> and <fr:tex display="inline"><![CDATA[U, x , V \to  z]]></fr:tex> then <fr:tex display="inline"><![CDATA[U , x/y , T , V \to  z]]></fr:tex></fr:li>
  <fr:li>if <fr:tex display="inline"><![CDATA[T \to  y]]></fr:tex> and <fr:tex display="inline"><![CDATA[U, x , V \to  z]]></fr:tex> then <fr:tex display="inline"><![CDATA[U , T, y \backslash  x , V \to  z]]></fr:tex></fr:li>
  <fr:li>if <fr:tex display="inline"><![CDATA[U , x , y , V \to  z]]></fr:tex> then <fr:tex display="inline"><![CDATA[U , xy , V \to  z]]></fr:tex></fr:li>
  <fr:li>if <fr:tex display="inline"><![CDATA[P \to  x]]></fr:tex> and <fr:tex display="inline"><![CDATA[Q \to  y]]></fr:tex> then <fr:tex display="inline"><![CDATA[P, Q \to  xy]]></fr:tex></fr:li></fr:ul></fr:p>
              </fr:mainmatter>
            </fr:tree>
