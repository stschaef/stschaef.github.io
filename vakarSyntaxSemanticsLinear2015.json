015"},{"t":"int","v":14},{"t":"str","v":"title:parametrized homotopy theory|2006"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":15},{"t":"str","v":"arxiv:1402.7041"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":15},{"t":"str","v":"title:quantization via linear homotopy types|2014"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":16},{"t":"str","v":"title:a general coherence result|1989"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":17},{"t":"str","v":"title:categorical semantics of linear logic|2009"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":19},{"t":"str","v":"title:on intuitionistic linear logic|1994"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":20},{"t":"str","v":"title:equality in hyperdoctrines and comprehension schema as an adjoint functor|1970"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":21},{"t":"str","v":"arxiv:quant-ph/0512114"}]},{"relation":"cites-key","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"int","v":21},{"t":"str","v":"title:a categorical quantum logic|2006"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"}]},{"relation":"import","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":"bibtex"},{"t":"str","v":"@misc{vakarSyntaxSemanticsLinear2015,\n title = {Syntax and {Semantics} of {Linear} {Dependent} {Types}},\n author = {Vákár, Matthijs},\n year = {2015},\n url = {http://arxiv.org/abs/1405.0033},\n urldate = {2024-07-10},\n publisher = {arXiv},\n keywords = {Computer Science - Logic in Computer Science, Computer Science - Programming Languages, Mathematics - Category Theory},\n note = {arXiv:1405.0033 [cs, math]},\n month = {January},\n language = {en},\n abstract = {A type theory is presented that combines (intuitionistic) linear types with type dependency, thus properly generalising both intuitionistic dependent type theory and full linear logic. A syntax and complete categorical semantics are developed, the latter in terms of (strict) indexed symmetric monoidal categories with comprehension. Various optional type formers are treated in a modular way. In particular, we will see that the historically much-debated multiplicative quantifiers and identity types arise naturally from categorical considerations. These new multiplicative connectives are further characterised by several identities relating them to the usual connectives from dependent type theory and linear logic. Finally, one important class of models, given by families with values in some symmetric monoidal category, is investigated in detail.}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":"entry-type"},{"t":"str","v":"misc"}]},{"relation":"meta","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":"month"},{"t":"int","v":1}]},{"relation":"meta","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":"publisher"},{"t":"str","v":"arXiv"}]},{"relation":"meta","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":"url"},{"t":"str","v":"http://arxiv.org/abs/1405.0033"}]},{"relation":"meta","args":[{"t":"entry","v":"vakarSyntaxSemanticsLinear2015"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"