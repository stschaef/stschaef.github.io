{"format":"helia-content","version":1,"id":"universal-element","title":{"Inline":[{"Text":"Universal Element of a Presheaf"}]},"title_text":"Universal Element of a Presheaf","kind":"definition","taxon":null,"url":"universal-element.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","universal-element"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"A "},{"Emph":[{"Text":"universal element"}]},{"Text":" of a presheaf "},{"Math":{"src":"P"}},{"Text":" on a category "},{"Math":{"src":"C"}},{"Text":" is an "},{"EntryLink":{"id":"element-of-presheaf","label":null,"body":[{"Text":"element"}]}},{"Text":" "},{"Math":{"src":"x ∈ P c"}},{"Text":", where "},{"Math":{"src":"c"}},{"Text":" is some object of "},{"Math":{"src":"C"}},{"Text":", demonstrating that "},{"Math":{"src":"P"}},{"Text":" is representable by "},{"Math":{"src":"c"}},{"Text":"."}]},{"Math":{"src":"P ≅ よ c"}},{"Paragraph":[{"Text":"(Slightly) more concretely, a universal element is captured by the following three pieces of data"}]},{"List":{"marker":null,"tight":true,"items":[{"Inline":[{"Text":"An object "},{"Math":{"src":"c"}},{"Text":" of "},{"Math":{"src":"C"}}]},{"Inline":[{"Text":"An element "},{"Math":{"src":"x ∈ P c"}}]},{"Inline":[{"Text":"A proof that the map sending a morphism "},{"Math":{"src":"f : b -> c"}},{"Text":" to "},{"Math":{"src":"( P f ) ( x )"}},{"Text":" is an equivalence"}]}]}},{"Paragraph":[{"Text":"This third point states that morphisms from "},{"Math":{"src":"b"}},{"Text":" into "},{"Math":{"src":"c"}},{"Text":" are uniquely determined by an element of "},{"Math":{"src":"P"}},{"Text":" at the domain "},{"Math":{"src":"b"}},{"Text":"."}]},{"Paragraph":[{"Text":"Or equivalently, universal elements are terminal in the category of elements."}]}]}}}]}}
