18"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"}]},{"relation":"import","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"bibtex"},{"t":"str","v":"@article{zhangIntervalParsingGrammars2023,\n title = {Interval {Parsing} {Grammars} for {File} {Format} {Parsing}},\n author = {Zhang, Jialun and Morrisett, Greg and Tan, Gang},\n year = {2023},\n doi = {10.1145/3591264},\n url = {https://dl.acm.org/doi/10.1145/3591264},\n urldate = {2024-04-29},\n journal = {Proceedings of the ACM on Programming Languages},\n volume = {7},\n number = {PLDI},\n pages = {1073--1095},\n month = {June},\n language = {en},\n abstract = {File formats specify how data is encoded for persistent storage. They cannot be formalized as context-free grammars since their specifications include context-sensitive patterns such as the random access pattern and the type-length-value pattern. We propose a new grammar mechanism called Interval Parsing Grammars IPGs) for file format specifications. An IPG attaches to every nonterminal/terminal an interval, which specifies the range of input the nonterminal/terminal consumes. By connecting intervals and attributes, the context-sensitive patterns in file formats can be well handled. In this paper, we formalize IPGs' syntax as well as its semantics, and its semantics naturally leads to a parser generator that generates a recursive-descent parser from an IPG. In general, IPGs are declarative, modular, and enable termination checking. We have used IPGs to specify a number of file formats including ZIP, ELF, GIF, PE, and part of PDF; we have also evaluated the performance of the generated parsers.},\n issn = {2475-1421}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"container"},{"t":"str","v":"Proceedings of the ACM on Programming Languages"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"doi"},{"t":"str","v":"10.1145/3591264"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"entry-type"},{"t":"str","v":"article"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"month"},{"t":"int","v":6}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"number"},{"t":"str","v":"PLDI"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"pages"},{"t":"str","v":"1073--1095"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"pdf-url"},{"t":"str","v":"https://dl.acm.org/doi/pdf/10.1145/3591264"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"pldb"},{"t":"str","v":"https://pldb.kirancodes.me/p/journals/pacmpl/ZhangMT23"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"url"},{"t":"str","v":"https://dl.acm.org/doi/10.1145/3591264"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"venue"},{"t":"str","v":"pldi"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"volume"},{"t":"str","v":"7"}]},{"relation":"meta","args":[{"t":"entry","v":"zhangIntervalParsingGrammars2023"},{"t":"str","v":"year"},{"t":"int","v":2023}]},{"relation":"path","args":[{"t":"entry","v":"zh