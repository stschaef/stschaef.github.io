wood"},{"t":"int","v":10},{"t":"str","v":"title:introduction to automata theory languages and computation|1979"}]},{"relation":"cites-key","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"int","v":11},{"t":"str","v":"title:iso 8879 standard generalized markup language sgml|1986"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":""}]},{"relation":"entry","args":[{"t":"entry","v":"bruggemannkleinwood"}]},{"relation":"import","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"bibtex"},{"t":"str","v":"@InProceedings{10.1007/3-540-55210-3_182,\nauthor=\"Br{\\\"u}ggemann-Klein, Anne\nand Wood, Derick\",\neditor=\"Finkel, Alain\nand Jantzen, Matthias\",\ntitle=\"Deterministic regular languages\",\nbooktitle=\"STACS 92\",\nyear=\"1992\",\npublisher=\"Springer Berlin Heidelberg\",\naddress=\"Berlin, Heidelberg\",\npages=\"173--184\",\nabstract=\"The ISO standard for Standard Generalized Markup Language (SGML) provides a syntactic meta-language for the definition of textual markup systems. In the standard the right hand sides of productions are called content models and they are based on regular expressions. The allowable regular expressions are those that are ``unambiguous'' as defined by the standard. Unfortunately, the standard's use of the term ``unambiguous'' does not correspond to the two well known notions, since not all regular languages are denoted by ``unambiguous'' expressions. Furthermore, the standard's definition of ``unambiguous'' is somewhat vague. Therefore, we provide a precise definition of ``unambiguous expressions'' and rename them deterministic regular expressions to avoid any confusion. A regular expression E is deterministic if the canonical $\\epsilon$-free finite automaton Merecognizing L(E) is deterministic. A regular language is deterministic if there is a deterministic expression that denotes it. We give a Kleene-like theorem for deterministic regular languages and we characterize them in terms of the structural properties of the minimal deterministic automata recognizing them. The latter result enables us to decide if a given regular expression denotes a deterministic regular language and, if so, to construct an equivalent deterministic expression.\",\nisbn=\"978-3-540-46775-5\"\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"container"},{"t":"str","v":"STACS 92"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"doi"},{"t":"str","v":"10.1007/3-540-55210-3_182"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"entry-type"},{"t":"str","v":"inproceedings"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"pages"},{"t":"str","v":"173--184"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"publisher"},{"t":"str","v":"Springer Berlin Heidelberg"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"venue"},{"t":"str","v":"stacs"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"year"},{"t":"int","v":1992}]},{"relation":"path","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"entries/refs/bruggemannkleinwood/bruggemannkleinwood.hel"}]},{"relation":"reference","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"inproceedings"},{"t":"int","v":1992}]},{"relation":"reference-pdf","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":""}]},{"relation":"tag","args":[{"t":"entry","v":"bruggemannkleinwood"},{"t":"str","v":"parsing"}]}