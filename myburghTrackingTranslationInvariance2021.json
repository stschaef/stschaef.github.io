"v":11},{"t":"str","v":"doi:10.1109/cvpr.2009.5206848"}]},{"relation":"cites-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"int","v":11},{"t":"str","v":"title:imagenet a large scale hierarchical image database|2009"}]},{"relation":"cites-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"int","v":12},{"t":"str","v":"title:mnist handwritten digit database|2010"}]},{"relation":"cites-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"int","v":13},{"t":"str","v":"doi:10.1109/5.726791"}]},{"relation":"cites-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"int","v":13},{"t":"str","v":"title:gradient based learning applied to document recognition|1998"}]},{"relation":"cites-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"int","v":14},{"t":"str","v":"title:cifar 10 canadian institute for advanced research"}]},{"relation":"cites-listed","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":""}]},{"relation":"date","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"date","v":"2021-04-19"}]},{"relation":"entry","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"}]},{"relation":"import","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"entry","v":"reference-kind"},{"t":"str","v":"reference"}]},{"relation":"kind","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"reference"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"bibtex"},{"t":"str","v":"@article{myburghTrackingTranslationInvariance2021,\n title = {Tracking Translation Invariance in {{CNNs}}},\n author = {Myburgh, Johannes C. and Mouton, Coenraad and Davel, Marelie H.},\n date = {2021-04-19},\n url = {http://arxiv.org/abs/2104.05997},\n urldate = {2024-01-15},\n keywords = {Computer Science - Machine Learning},\n pubstate = {prepublished},\n abstract = {Although Convolutional Neural Networks (CNNs) are widely used, their translation invariance (ability to deal with translated inputs) is still subject to some controversy. We explore this question using translation-sensitivity maps to quantify how sensitive a standard CNN is to a translated input. We propose the use of Cosine Similarity as sensitivity metric over Euclidean Distance, and discuss the importance of restricting the dimensionality of either of these metrics when comparing architectures. Our main focus is to investigate the effect of different architectural components of a standard CNN on that network's sensitivity to translation. By varying convolutional kernel sizes and amounts of zero padding, we control the size of the feature maps produced, allowing us to quantify the extent to which these elements influence translation invariance. We also measure translation invariance at different locations within the CNN to determine the extent to which convolutional and fully connected layers, respectively, contribute to the translation invariance of a CNN as a whole. Our analysis indicates that both convolutional kernel size and feature map size have a systematic influence on translation invariance. We also see that convolutional layers contribute less than expected to translation invariance, when not specifically forced to do so.},\n eprintclass = {cs},\n eprinttype = {arXiv},\n eprint = {2104.05997}\n}"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"date"},{"t":"date","v":"2021-04-19"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"entry-type"},{"t":"str","v":"article"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"eprint"},{"t":"str","v":"2104.05997"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"url"},{"t":"str","v":"http://arxiv.org/abs/2104.05997"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"venue"},{"t":"str","v":"arxiv"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"visibility"},{"t":"str","v":"public"}]},{"relation":"meta","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"year"},{"t":"int","v":2021}]},{"relation":"path","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"entries/refs/myburghTrackingTranslationInvariance2021/myburghTrackingTranslationInvariance2021.hel"}]},{"relation":"reference","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"article"},{"t":"int","v":2021}]},{"relation":"reference-pdf","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"acd29375eb606cf6b96acc1d6d9662e05c20bdd673809b1231621c612e5cb6eb"}]},{"relation":"tag","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"machine-learning"}]},{"relation":"tag","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"machine-learning-verification"}]},{"relation":"title","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"content","v":{"Inline":[{"Text":"Tracking translation invariance in CNNs"}]}}]},{"relation":"visibility","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"public"}]},{"relation":"work-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"arxiv:2104.05997"}]},{"relation":"work-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"title:tracking translation invariance in cnns"}]},{"relation":"work-key","args":[{"t":"entry","v":"myburghTrackingTranslationInvariance2021"},{"t":"str","v":"t