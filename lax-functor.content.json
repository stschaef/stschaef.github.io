{"format":"helia-content","version":1,"id":"lax-functor","title":{"Inline":[{"Text":"Lax Functor"}]},"title_text":"Lax Functor","kind":"definition","taxon":null,"url":"lax-functor.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","lax-functor"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"A "},{"Emph":[{"Text":"lax functor"}]},{"Text":" "},{"Math":{"src":"F : cal(B) -> cal(C)"}},{"Text":" between "},{"EntryLink":{"id":"bicategory","label":null,"body":[{"Text":"bicategories"}]}},{"Text":" consists of"}]},{"Enum":{"numbering":null,"start":1,"tight":true,"items":[{"number":null,"body":{"Inline":[{"Text":"a map on 0-cells, "},{"Math":{"src":"x |-> F x"}},{"Text":";"}]}},{"number":null,"body":{"Inline":[{"Text":"for all "},{"Math":{"src":"x, y"}},{"Text":", a functor "},{"Math":{"src":"F_(x,y) : cal(B) (x, y) -> cal(C) (F x, F y)"}},{"Text":", acting on 1-cells and 2-cells;"}]}},{"number":null,"body":{"Inline":[{"Text":"a "},{"Emph":[{"Text":"unit"}]},{"Text":" comparison, natural 2-cells "},{"Math":{"src":"F^0_x : 1_(F x) => F(1_x)"}},{"Text":";"}]}},{"number":null,"body":{"Inline":[{"Text":"a "},{"Emph":[{"Text":"composition"}]},{"Text":" comparison, 2-cells "},{"Math":{"src":"F^2_(f, g) : F f ⋆ F g => F(f ⋆ g)"}},{"Text":" natural in "},{"Math":{"src":"f"}},{"Text":" and "},{"Math":{"src":"g"}},{"Text":";"}]}},{"number":null,"body":{"Block":[{"Paragraph":[{"Text":"such that three coherence laws hold, one for each structure cell of "},{"Math":{"src":"cal(B)"}},{"Text":":"}]},{"List":{"marker":null,"tight":true,"items":[{"Inline":[{"Text":"left unit: "},{"Math":{"src":"(F^0 ▷ F f) ⋆ F^2_(1, f) ⋆ F(lambda_f) = lambda_(F f)"}},{"Text":";"}]},{"Inline":[{"Text":"right unit: "},{"Math":{"src":"(F f ◁ F^0) ⋆ F^2_(f, 1) ⋆ F(rho_f) = rho_(F f)"}},{"Text":";"}]},{"Inline":[{"Text":"associativity: "},{"Math":{"src":"(F^2_(f,g) ▷ F h) ⋆ F^2_(f ⋆ g, h) ⋆ F(alpha_(f,g,h))\n    = alpha_(F f, F g, F h) ⋆ (F f ◁ F^2_(g,h)) ⋆ F^2_(f, g ⋆ h)"}},{"Text":"."}]}]}}]}}]}},{"Paragraph":[{"Text":"Here "},{"Math":{"src":"⋆"}},{"Text":" between 2-cells is vertical composition, and "},{"Math":{"src":"theta ▷ h"}},{"Text":" and "},{"Math":{"src":"h ◁ theta"}},{"Text":" are whiskerings."}]},{"Paragraph":[{"Text":"Lax functors compose: "},{"Math":{"src":"(G ∘ F)^0 = G^0 ⋆ G(F^0)"}},{"Text":" and "},{"Math":{"src":"(G ∘ F)^2_(f,g) = G^2_(F f, F g) ⋆ G(F^2_(f,g))"}},{"Text":". The coherence laws of the composite follow from those of "},{"Math":{"src":"F"}},{"Text":" and "},{"Math":{"src":"G"}},{"Text":" and naturality of "},{"Math":{"src":"G^2"}},{"Text":", without using the triangle or pentagon of any of the bicategories involved."}]},{"Paragraph":[{"Text":"A lax functor whose comparison cells are invertible is a "},{"EntryLink":{"id":"pseudofunctor","label":null,"body":[{"Text":"pseudofunctor"}]}},{"Text":"."}]}]}}}]}}
