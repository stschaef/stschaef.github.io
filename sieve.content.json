{"format":"helia-content","version":1,"id":"sieve","title":{"Inline":[{"Text":"Sieves"}]},"title_text":"Sieves","kind":"definition","taxon":null,"url":"sieve.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","sieve"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"A "},{"Emph":[{"Text":"sieve"}]},{"Text":" on an object "},{"Math":{"src":"x"}},{"Text":" of "},{"Math":{"src":"cal(C)"}},{"Text":" is a subobject of the representable presheaf "},{"Math":{"src":"sans(\"y\") thin x"}},{"Text":": a presheaf "},{"Math":{"src":"S"}},{"Text":" with a monic morphism "},{"Math":{"src":"S ↣ sans(\"y\") thin x"}},{"Text":". Sieves are a generalization from the notion of "},{"Emph":[{"Text":"ideal"}]},{"Text":" found in ring theory to category theory."}]},{"Paragraph":[{"Text":"A morphism "},{"Math":{"src":"f : y -> x"}},{"Text":" "},{"Emph":[{"Text":"belongs"}]},{"Text":" to "},{"Math":{"src":"S"}},{"Text":", written "},{"Math":{"src":"S ∋ f"}},{"Text":", when "},{"Math":{"src":"f"}},{"Text":" lies in the image of the inclusion at "},{"Math":{"src":"y"}},{"Text":". Because "},{"Math":{"src":"S"}},{"Text":" is a presheaf and the inclusion is natural, membership is closed under precomposition:"}]},{"Math":{"src":"S ∋ f => S ∋ g ⋆ f quad \"for every \" g : z -> y ."}},{"Paragraph":[{"Text":"A sieve is thus a “downward closed” collection of morphisms into "},{"Math":{"src":"x"}},{"Text":"."}]},{"Paragraph":[{"Text":"Sieves on "},{"Math":{"src":"x"}},{"Text":" are ordered by "},{"Emph":[{"Text":"refinement"}]},{"Text":": "},{"Math":{"src":"S ⊆ T"}},{"Text":" when every morphism belonging to "},{"Math":{"src":"S"}},{"Text":" belongs to "},{"Math":{"src":"T"}},{"Text":"."}]}]}}}]}}
