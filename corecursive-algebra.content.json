{"format":"helia-content","version":1,"id":"corecursive-algebra","title":{"Inline":[{"Text":"Corecursive algebra"}]},"title_text":"Corecursive algebra","kind":"definition","taxon":null,"url":"corecursive-algebra.html","content":{"Block":[{"Group":{"role":"env","attrs":[["entry","corecursive-algebra"],["kind","definition"],["label","Definition"],["numbered","true"]],"body":{"Block":[{"Paragraph":[{"Text":"Fix an endofunctor "},{"Math":{"src":"F : cal(C) -> cal(C)"}},{"Text":". An "},{"EntryLink":{"id":"algebras-displayed","label":null,"body":[{"Text":"algebra"}]}},{"Text":" "},{"Math":{"src":"alpha : F B -> B"}},{"Text":" is "},{"Emph":[{"Text":"corecursive"}]},{"Text":" when for every "},{"EntryLink":{"id":"coalgebras-displayed","label":null,"body":[{"Text":"coalgebra"}]}},{"Text":" "},{"Math":{"src":"gamma : X -> F\nX"}},{"Text":" there is exactly one "},{"EntryLink":{"id":"hylomorphism","label":null,"body":[{"Text":"hylomorphism"}]}},{"Text":" from "},{"Math":{"src":"gamma"}},{"Text":" to "},{"Math":{"src":"alpha"}},{"Text":". Equivalently, the functor "},{"Math":{"src":"sans(\"Hylo\")(-,\nalpha)"}},{"Text":" of the "},{"EntryLink":{"id":"hylomorphism-profunctor","label":null,"body":[{"Text":"hylomorphism profunctor"}]}},{"Text":" is constantly a singleton. It is the dual of a "},{"EntryLink":{"id":"recursive-coalgebra","label":null,"body":[{"Text":"recursive coalgebra"}]}},{"Text":": an "},{"Math":{"src":"F"}},{"Text":"-algebra in "},{"Math":{"src":"cal(C)"}},{"Text":" is corecursive exactly when it is recursive as an "},{"Math":{"src":"F^(\"op\")"}},{"Text":"-coalgebra in "},{"Math":{"src":"cal(C)^(\"op\")"}},{"Text":"."}]},{"Paragraph":[{"Strong":[{"Text":"Example."}]},{"Text":" If "},{"Math":{"src":"(nu F, sans(\"out\"))"}},{"Text":" is a "},{"EntryLink":{"id":"terminal-coalgebra","label":null,"body":[{"Text":"terminal coalgebra"}]}},{"Text":", then "},{"Math":{"src":"sans(\"out\")"}},{"Text":" is invertible and "},{"Math":{"src":"sans(\"out\")^(-1) : F (nu F) -> nu F"}},{"Text":" is a corecursive algebra: a solution of "},{"Math":{"src":"h = gamma ⋆ F h ⋆\nsans(\"out\")^(-1)"}},{"Text":" is the same thing as a solution of "},{"Math":{"src":"h ⋆\nsans(\"out\") = gamma ⋆ F h"}},{"Text":", that is, a coalgebra map into the terminal coalgebra, and there is exactly one, "},{"Math":{"src":"sans(\"unfold\") thin gamma"}},{"Text":"."}]}]}}}]}}
